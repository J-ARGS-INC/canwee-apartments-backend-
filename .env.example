PORT=4000
# Comma-separated allowlist. Keep localhost for local dev alongside the
# production domain so both work without swapping env files.
CORS_ORIGIN=http://localhost:5173,https://canweeapartments.com,https://www.canweeapartments.com

# Deprecated: admin auth is now individual accounts (see admin_users table,
# `npm run seed:admins`) + JWT sessions, not a shared key. Nothing checks
# this anymore. Safe to remove once you've confirmed the new login works.
ADMIN_API_KEY=change-me

# Signs the session tokens issued by POST /api/admin/login. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this instantly invalidates every admin's current session.
JWT_SECRET=change-me

# Booking/contact notification emails, sent via Brevo (https://brevo.com).
# BREVO_FROM_EMAIL must be a sender verified in your Brevo account (Settings
# -> Senders, Domains & Dedicated IPs -> Senders) or sending will fail.
BREVO_API_KEY=
BREVO_FROM_EMAIL=support@canweeapartments.com
BREVO_FROM_NAME=Canwee Apartments
# Comma-separated list of addresses that receive new booking/contact alerts.
NOTIFY_EMAILS=support@canweeapartments.com,jargsltd@gmail.com

# Used to build links inside emails (guest "check your status" link, admin
# "open dashboard" link). ADMIN_DASHBOARD_URL includes the obscured admin
# path — update both here and in src/App.jsx if that path ever changes.
FRONTEND_URL=https://canweeapartments.com
ADMIN_DASHBOARD_URL=https://canweeapartments.com/2889bc29ed60/admin

# From your Supabase project settings -> Database -> Connection string
# (session pooler). Kept as discrete fields rather than one URL so a
# password with special characters never has to be percent-encoded by hand.
PGHOST=aws-0-eu-west-1.pooler.supabase.com
PGPORT=5432
PGUSER=postgres.your-project-ref
PGPASSWORD=your-db-password
PGDATABASE=postgres
