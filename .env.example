PORT=4000
# Comma-separated allowlist. Keep localhost for local dev alongside the
# production domain so both work without swapping env files.
CORS_ORIGIN=http://localhost:5173,https://canweeapartments.com,https://www.canweeapartments.com

# Shared secret for the /admin dashboard (check-in/check-out). Generate with:
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_API_KEY=change-me

# From your Supabase project settings -> Database -> Connection string
# (session pooler). Kept as discrete fields rather than one URL so a
# password with special characters never has to be percent-encoded by hand.
PGHOST=aws-0-eu-west-1.pooler.supabase.com
PGPORT=5432
PGUSER=postgres.your-project-ref
PGPASSWORD=your-db-password
PGDATABASE=postgres
